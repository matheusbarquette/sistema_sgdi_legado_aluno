          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (evento) (count_over_time({service_name=\"sgdi\"} | evento=~\"demanda_criada|demanda_deletada|comentario_criado|busca\" [1m]))",
          "legendFormat": "{{evento}}"
