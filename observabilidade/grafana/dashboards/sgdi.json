          "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"sgdi\", http_route=~\"$rota\", http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{job=\"sgdi\", http_route=~\"$rota\"}[$__rate_interval]))",
          "legendFormat": "",
