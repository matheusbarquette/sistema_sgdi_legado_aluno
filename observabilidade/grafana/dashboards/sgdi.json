    {
      "type": "timeseries",
      "title": "Resultados por busca (média)",
      "id": 10,
      "description": "unwrap transforma o campo quantidade_resultados do log em número: soma / contagem.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum(sum_over_time({service_name=\"sgdi\"} | evento=\"busca\" | unwrap quantidade_resultados [$__auto])) / sum(count_over_time({service_name=\"sgdi\"} | evento=\"busca\" [$__auto]))",
